{
  "name": "circleso",
  "version": "0.3.0",
  "description": "Circleso async client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atomimus/circleso.git"
  },
  "bugs": {
    "url": "https://github.com/atomimus/circleso/issues"
  },
  "homepage": "https://github.com/atomimus/circleso#readme",
  "keywords": [
    "circle.so",
    "circleso",
    "sdk",
    "api",
    "headless"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./admin": {
      "import": {
        "types": "./dist/admin.d.ts",
        "default": "./dist/admin.js"
      },
      "require": {
        "types": "./dist/admin.d.cts",
        "default": "./dist/admin.cjs"
      }
    },
    "./headless": {
      "import": {
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.js"
      },
      "require": {
        "types": "./dist/headless.d.cts",
        "default": "./dist/headless.cjs"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/auth.d.ts",
        "default": "./dist/auth.js"
      },
      "require": {
        "types": "./dist/auth.d.cts",
        "default": "./dist/auth.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "openapi-fetch": "0.15.0",
    "openapi-typescript-helpers": "0.0.15"
  },
  "scripts": {
    "build": "tsx ./scripts/build.ts",
    "test": "vitest run",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "tsx ./scripts/lint.ts",
    "format": "biome format --write .",
    "spec:sync": "tsx ./scripts/spec-sync.ts",
    "spec:check": "tsx ./scripts/spec-sync.ts --check",
    "gen:types": "tsx ./scripts/gen-types.ts",
    "gen:check": "tsx ./scripts/gen-types.ts --check",
    "coverage:api": "tsx ./scripts/api-coverage.ts",
    "coverage:write": "tsx ./scripts/api-coverage.ts --write",
    "coverage:check": "tsx ./scripts/api-coverage.ts --check",
    "pack:check": "npm pack --dry-run --json --ignore-scripts",
    "test:package": "tsx ./scripts/package-check.ts",
    "validate:ci": "npm run lint && npm run typecheck && npm test && npm run gen:check && npm run coverage:check && npm run build && npm run pack:check && npm run test:package",
    "prepublishOnly": "npm run gen:types && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@redocly/openapi-core": "1.34.6",
    "@types/node": "22.20.5",
    "esbuild": "0.27.2",
    "openapi-typescript": "7.10.1",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-current": "npm:typescript@7.0.2",
    "vitest": "4.0.16"
  }
}
